<% count_page "form", (@referral.present? && !@error ? [["Referral: Visit", { landing: "waitlist form" }]] : []) %>
<% content_for :title, "Join the #{@product.name} waitlist" %>
<h1>Join the <%= @product.name %> waitlist</h1>
<p class="lede">Leave your email and we'll write when there is a place for you.</p>

<%= form_with url: product_signups_path(@product.slug), method: :post, authenticity_token: false, local: true, class: "signup" do %>
  <% if @embedded %><input type="hidden" name="embed" value="1"><% end %>
  <input type="hidden" name="started" value="<%= SpamCheck.started_token %>">
  <% if @referral %><input type="hidden" name="ref" value="<%= @referral %>"><% end %>
  <% if @error %><p class="error" role="alert"><%= @error %></p><% end %>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required value="<%= params[:email] %>">

  <% if @product.questions.any? %>
    <fieldset class="questions">
      <legend>A few questions, all optional</legend>
      <% @product.questions.each_with_index do |q, i| %>
        <label for="q<%= i %>"><%= q["question"] %></label>
        <select id="q<%= i %>" name="answers[<%= q["question"] %>]">
          <option value="">Choose one</option>
          <% q["options"].each do |option| %>
            <option value="<%= option %>" <%= "selected" if params.dig(:answers, q["question"]) == option %>><%= option %></option>
          <% end %>
        </select>
      <% end %>
    </fieldset>
  <% end %>

  <div class="trap" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  <button type="submit">Join the waitlist</button>
  <p class="fine"><%= Signup::CONSENT_TEXT %> We'll email you a link to confirm. <a href="<%= @product.privacy_url %>" target="_top">How we handle your details</a>.</p>
<% end %>
