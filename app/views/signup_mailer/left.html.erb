<%= render "shared/email_heading", text: "You've left the waitlist" %>
<p style="margin:0 0 16px;">Your address and answers have been deleted from the <%= @product.name %> waitlist. You won't hear from us about it again.</p>
<p style="margin:0;font-size:15px;color:<%= brand["muted"] %>;">Changed your mind? You can <a href="<%= product_form_url(@product.slug) %>" style="color:<%= brand["text"] %>;">sign up again</a> at any time.</p>
