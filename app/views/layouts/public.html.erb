<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title><%= content_for(:title) || @product&.name || "Waitlist" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="referrer" content="no-referrer">
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "copy", defer: true %>
  </head>
  <body class="<%= "embedded" if @embedded %>">
    <main class="card">
      <%= yield %>
    </main>
    <% if @product && !@embedded %>
      <footer>
        <a href="<%= @product.site_url %>"><%= @product.name %></a>
        <a href="<%= @product.privacy_url %>">Privacy</a>
      </footer>
    <% end %>
  </body>
</html>
