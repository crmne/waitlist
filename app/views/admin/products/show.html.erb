<% content_for :title, "#{@product.name} waitlist" %>
<h1><%= @product.name %></h1>
<% @product.signup_experiment_reports.each do |report| %>
  <section class="experiment-report" aria-label="Signup experiment <%= report[:name] %>">
    <h2>Signup experiment: <%= report[:name] %></h2>
    <p class="fine">Signups from <%= report[:since].utc.strftime("%d %b %Y, %H:%M UTC") %><% if report[:ended_at] %> to <%= report[:ended_at].utc.strftime("%d %b %Y, %H:%M UTC") %><% end %>, across every status. Unattributed means the variant was not recorded. Deleted or expired entries are excluded.</p>
    <table>
      <thead><tr><th>Variant</th><th class="n">Signed up</th><th class="n">Confirmed</th><th class="n">Pending</th></tr></thead>
      <tbody>
        <% report[:rows].each do |row| %>
          <tr><td><%= row[:variant] %></td><td class="n"><%= row[:total] %></td><td class="n"><%= row[:confirmed] %></td><td class="n"><%= row[:pending] %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
<nav class="tabs">
  <% Admin::ProductsController::STATUSES.each do |status| %>
    <a href="<%= admin_product_path(@product, status:) %>" class="<%= "current" if status == @status %>"><%= status.capitalize %></a>
  <% end %>
  <a href="<%= export_admin_product_path(@product) %>">Export CSV</a>
</nav>
<form method="get" class="search">
  <input type="hidden" name="status" value="<%= @status %>">
  <input type="search" name="q" value="<%= params[:q] %>" placeholder="Find an email" aria-label="Find an email">
</form>
<table>
  <thead>
    <tr><th class="n">#</th><th>Email</th><th>Signed up</th><th class="n">Referrals</th><% @product.question_titles.each do |q| %><th><%= q %></th><% end %><th></th></tr>
  </thead>
  <tbody>
    <% @signups.each_with_index do |signup, i| %>
      <tr id="signup-<%= signup.id %>">
        <td class="n"><%= i + 1 %></td>
        <td><%= signup.email %><% if signup.source != "form" %> <span class="tag"><%= signup.source %></span><% end %></td>
        <td class="date"><%= signup.created_at.to_date.iso8601 %></td>
        <td class="n"><%= signup.effective_referrals %></td>
        <% @product.question_titles.each do |q| %><td><%= signup.answers[q] %></td><% end %>
        <td><div class="actions">
          <% if signup.status == "waiting" %>
            <%= button_to "Approve", approve_admin_signup_path(signup), method: :post %>
          <% elsif (state = signup.approval_state) %>
            <span class="tag"><%= state == "approved" ? "Approved" : @product.approval_label(state) %></span>
            <% if signup.approval_retryable? %><%= button_to "Try again", retry_approval_admin_signup_path(signup), method: :post %><% end %>
          <% end %>
          <a href="<%= delete_admin_signup_path(signup) %>" class="quiet">Delete</a>
        </div></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @signups.empty? %><p class="fine">Nobody here.</p><% end %>
