<h1>Waitlists</h1>
<table>
  <thead><tr><th>Product</th><th class="n">Waiting</th><th class="n">Unconfirmed</th><th class="n">Approved</th><th class="n">Approval unfinished</th><th></th></tr></thead>
  <tbody>
    <% @products.each do |product| %>
      <% unconfirmed, waiting, approved, pending = @counts.fetch(product.id, [0, 0, 0, 0]) %>
      <tr>
        <td><a href="<%= admin_product_path(product) %>"><%= product.name %></a></td>
        <td class="n"><%= waiting %></td>
        <td class="n"><%= unconfirmed %></td>
        <td class="n"><%= approved %></td>
        <td class="n"><%= product.on_approve ? pending : "" %></td>
        <td><a href="<%= export_admin_product_path(product) %>">Export CSV</a></td>
      </tr>
    <% end %>
  </tbody>
</table>
<p class="fine">Unconfirmed signups are deleted after their confirmation deadline. Products with confirmation reminders allow 14 days, extended for late reminders; other products allow <%= Rails.configuration.x.unconfirmed_retention.in_days.to_i %> days. Approved signups use each product's keep period.</p>
