<% count_page "confirmed", [["Waitlist: Confirmed", { referral: @signup.referred_by_id ? "yes" : "no" }.merge(@signup.experiment_properties)]] %>
<% content_for :title, "You're on the list" %>
<h1>You're on the list</h1>
<% if (place = @signup.place_in_line) %>
  <p class="lede">You're number <%= place %> on the <%= @product.name %> waitlist. We'll write when there is a place for you.</p>
<% else %>
  <p class="lede">Your place on the <%= @product.name %> waitlist is confirmed.</p>
<% end %>
<% if @product.places_per_referral.positive? %>
  <label for="referral-link">Your link</label>
  <div class="share">
    <input id="referral-link" type="text" readonly value="<%= product_form_url(@product.slug, ref: @signup.referral_code) %>">
    <button type="button" data-copy="#referral-link">Copy</button>
  </div>
  <p class="fine">Share it: for everyone who joins through it and confirms their email, you move up <%= @product.places_per_referral %> places. We never tell you who they are.</p>
<% end %>
<p class="fine">Changed your mind? <a href="<%= leave_path(@signup.generate_token_for(:leave)) %>">Leave the list and delete your details</a>.</p>
